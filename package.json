{
  "name": "vda5050-visualizer",
  "author": "bekir.bostanci",
  "version": "2.2.0",
  "scripts": {
    "dev": "vite --host --port 8082",
    "build:bundle": "vite build",
    "preview": "vite preview --host",
    "test:unit": "vitest --environment jsdom",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,vue,json,css,scss,md}\"",
    "electron:dev": "concurrently \"vite --host --port 8082\" \"wait-on tcp:8082 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@radix-icons/vue": "^1.0.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-inject": "^5.0.3",
    "@vee-validate/zod": "^4.15.1",
    "@vercel/analytics": "^1.4.1",
    "@vueuse/core": "^14.0.0",
    "bootstrap-icons": "^1.9.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.3.1",
    "electron-updater": "^6.8.9",
    "lodash": "^4.18.1",
    "mqtt": "^5.10.1",
    "pinia": "^3.0.4",
    "process": "^0.11.10",
    "radix-vue": "^1.9.17",
    "randomcolor": "^0.6.2",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.1",
    "uuid": "^11.1.1",
    "v-network-graph": "^0.9.7",
    "vda-5050-lib": "github:bekirbostanci/vda-5050-lib",
    "vee-validate": "^4.15.1",
    "vite": "^6.4.3",
    "vue": "^3.4.23",
    "vue-i18n": "^9.2.2",
    "vue-json-pretty": "^2.2.4",
    "vue-router": "^4.1.5",
    "vue3-loading-skeleton": "^0.0.13",
    "webpack": "^5.109.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.19.1",
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/jsdom": "^20.0.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.1",
    "@types/randomcolor": "^0.5.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/test-utils": "^2.0.2",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.4.22",
    "babel-loader": "^8.2.5",
    "concurrently": "^9.2.1",
    "cypress": "^15.20.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.22.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-vue": "^9.3.0",
    "jsdom": "^20.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^2.7.1",
    "process": "^0.11.10",
    "rimraf": "^5.0.1",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~4.7.4",
    "vite-plugin-commonjs": "^0.10.4",
    "vitest": "^3.2.7",
    "vue-loader": "^16.8.3",
    "vue-tsc": "^0.40.7",
    "wait-on": "^8.0.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "tmp": "^0.2.7",
    "js-cookie": "^3.0.8",
    "fast-uri": "^3.1.5",
    "defu": "^6.1.7",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "@xmldom/xmldom": "^0.8.14",
    "flatted": "^3.4.4",
    "immutable@5": "5.1.9",
    "serialize-javascript": "^7.1.0",
    "rollup": "^4.62.4",
    "axios": "^1.19.0",
    "tar": "^7.5.22",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "nanoid@3": "3.3.18",
    "nanoid@5": "5.1.16",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "js-yaml": "^4.3.1",
    "ip-address": "^10.5.0",
    "builder-util-runtime": "^9.7.0",
    "qs": "^6.15.3",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.vda5050-visualizer",
    "productName": "vda5050-visualizer",
    "icon": "public/icon.png",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bekirbostanci",
        "repo": "vda5050_visualizer"
      }
    ],
    "win": {
      "target": "nsis",
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": "dmg",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": "AppImage",
      "publish": [
        "github"
      ]
    }
  }
}
